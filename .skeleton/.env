# ------------------------------------------------------------------------------
# Palworld version override. Update this value and restart your containers
# (i.e. 'docker compose up -d') to update your installation.
# ------------------------------------------------------------------------------

# PALWORLD_VERSION=latest

# ------------------------------------------------------------------------------
# The Palworld server port to be exposed to the host.
# ------------------------------------------------------------------------------

# PALWORLD_PORT=8211

# ------------------------------------------------------------------------------
# Path to the Palworld data directories. These paths may be absolute or
# relative to the 'docker-compose.yaml' file.
# ------------------------------------------------------------------------------

# PALWORLD_DATA_PATH=./data

# ------------------------------------------------------------------------------
# Host process user and group IDs. Setting these will map the host user/group
# to the user/group running within the container. This helps avoid permission
# issues between your host machine and docker container.
# ------------------------------------------------------------------------------

# HOST_USER_ID=
# HOST_GROUP_ID=
